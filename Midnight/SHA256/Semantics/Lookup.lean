import Midnight.SHA256.Semantics.Spread

/-! The lookup relation generated by the actual Midnight SHA table. The field
results use canonical representatives, so modular aliases cannot satisfy a
word-range claim accidentally. This module proves table meaning; callers must
still establish that their circuit lookup constraints enforce this membership. -/

namespace Midnight.SHA256.Semantics

/-- Exact membership in the existing source table, with no captured rows. -/
theorem mem_spreadRows_iff (width plain expanded : Nat) :
    (width, plain, expanded) ∈ spreadRows ↔
      width ∈ spreadWidths ∧ plain < 2 ^ width ∧ expanded = spread plain := by
  simp only [spreadRows, List.mem_flatMap, List.mem_map, List.mem_range, Prod.mk.injEq]
  constructor
  · rintro ⟨w, hw, n, hn, hw', hn', hs⟩
    subst width; subst plain
    exact ⟨hw, hn, hs.symm⟩
  · rintro ⟨hw, hn, rfl⟩
    exact ⟨width, hw, plain, hn, rfl, rfl, rfl⟩

theorem spreadWidth_le_twelve {width : Nat} (h : width ∈ spreadWidths) : width ≤ 12 := by
  simp [spreadWidths] at h
  omega

/-- Field triples have exactly the row-wise casts loaded by `loadSpread`. -/
def spreadFieldRows : List (F × F × F) :=
  spreadRows.map fun row => ((row.1 : F), (row.2.1 : F), (row.2.2 : F))

def SpreadLookup (tag plain expanded : F) : Prop :=
  (tag, plain, expanded) ∈ spreadFieldRows

theorem spreadRow_canonical {width plain expanded : Nat}
    (h : (width, plain, expanded) ∈ spreadRows) :
    width < BLS12_381.scalarFieldSize ∧ plain < BLS12_381.scalarFieldSize ∧
      expanded < BLS12_381.scalarFieldSize := by
  obtain ⟨hw, hn, rfl⟩ := (mem_spreadRows_iff _ _ _).mp h
  have hwidth := spreadWidth_le_twelve hw
  have hn' : plain < 2 ^ 12 := hn.trans_le (Nat.pow_le_pow_right (by decide) hwidth)
  have hs : spread plain < 2 ^ 24 := by
    have h := spread_lt hn'
    exact h
  exact ⟨by norm_num [BLS12_381.scalarFieldSize]; omega,
    hn'.trans (by norm_num [BLS12_381.scalarFieldSize]),
    hs.trans (by norm_num [BLS12_381.scalarFieldSize])⟩

/-- A satisfied table membership proves the actual input bound and exact spread
of its canonical representative. Width zero is the disabled all-zero row. -/
theorem spreadLookup_iff (tag plain expanded : F) : SpreadLookup tag plain expanded ↔
    tag.val ∈ spreadWidths ∧ plain.val < 2 ^ tag.val ∧ expanded.val = spread plain.val := by
  constructor
  · intro h
    obtain ⟨⟨width, n, s⟩, hm, heq⟩ := List.mem_map.mp h
    have bounds := spreadRow_canonical hm
    have ht : tag.val = width := by
      have h := congrArg (fun row : F × F × F => row.1.val) heq
      simpa only [ZMod.val_natCast, Nat.mod_eq_of_lt bounds.1] using h.symm
    have hp : plain.val = n := by
      have h := congrArg (fun row : F × F × F => row.2.1.val) heq
      simpa only [ZMod.val_natCast, Nat.mod_eq_of_lt bounds.2.1] using h.symm
    have hs : expanded.val = s := by
      have h := congrArg (fun row : F × F × F => row.2.2.val) heq
      simpa only [ZMod.val_natCast, Nat.mod_eq_of_lt bounds.2.2] using h.symm
    rw [ht, hp, hs]
    exact (mem_spreadRows_iff _ _ _).mp hm
  · intro h
    apply List.mem_map.mpr
    refine ⟨(tag.val, plain.val, expanded.val), (mem_spreadRows_iff _ _ _).mpr h, ?_⟩
    simp only [ZMod.natCast_zmod_val]

end Midnight.SHA256.Semantics
