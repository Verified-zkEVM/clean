import Midnight.SHA256.Semantics.WitnessErasureCheckpoints.Reduction

namespace Midnight.SHA256.Semantics.WitnessErasureCheckpoints
open Halo2

sha256_erasure_reduction in

theorem serialize5Checked : Checked StructuralCheckpoints.serialize5Action
    StructuralCheckpoints.serialize4After StructuralCheckpoints.serialize5Output StructuralCheckpoints.serialize5After
    ((WitnessCheckpoints.serialize5Operations 0).map WitnessErasure.Code.encode) := by
  conv => arg 5; cbv
  intro priorTrace
  cases priorTrace with
  | mk data =>
    cbv
    repeat' apply And.intro
    all_goals trivial

end Midnight.SHA256.Semantics.WitnessErasureCheckpoints
