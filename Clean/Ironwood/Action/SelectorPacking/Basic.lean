import Clean.Ironwood.Action.PlannerTrace

/-!
# Reduced Orchard Action selector packing

Halo 2's greedy selector compressor asks only a small finite set of pairwise
conflict questions. Each packing step reduces its questions independently, so
kernel checking never repeatedly expands the complete activation stream.
-/

register_simp_attr action_selector_rows_norm

namespace Zcash.Circuits.Action

open Halo2 FloorPlanner

def expandSelectorRowRuns (runs : List (ℕ × ℕ)) : List ℕ :=
  runs.flatMap fun run => (List.range run.2).map (run.1 + ·)

